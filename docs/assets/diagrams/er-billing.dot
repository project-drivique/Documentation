"billing.payment_statuses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>billing.payment_statuses</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_final</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"billing.payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>billing.payments</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">contract_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">payment_method_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">status_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">gateway_provider</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">gateway_reference</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">NUMERIC(12, 2)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">currency_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">paid_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">confirmed_by_user_id</TD><TD ALIGN="LEFT">UUID ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
