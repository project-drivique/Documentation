digraph ER {
graph [rankdir=LR, bgcolor="white", nodesep="0.35", ranksep="1.3", splines=polyline, overlap=false, label="Drivique ER — esquema core — ? admite NULL", labelloc=t, fontsize=20, fontname="Arial"];
node [shape=plain,fontname="Arial"];
edge [fontname="Arial",fontsize=8,dir=none,color="#667085"];
"core.brand_configurations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>core.brand_configurations</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">company_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">logo_url</TD><TD ALIGN="LEFT">VARCHAR(2048) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">favicon_url</TD><TD ALIGN="LEFT">VARCHAR(2048) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">primary_color</TD><TD ALIGN="LEFT">VARCHAR(7)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">secondary_color</TD><TD ALIGN="LEFT">VARCHAR(7)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">accent_color</TD><TD ALIGN="LEFT">VARCHAR(7)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">default_theme</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"core.currencies" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>core.currencies</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">symbol</TD><TD ALIGN="LEFT">VARCHAR(5)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_default</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"core.exchange_rates" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>core.exchange_rates</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">from_currency_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">to_currency_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rate</TD><TD ALIGN="LEFT">NUMERIC(16, 6)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">provider</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fetched_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"core.languages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>core.languages</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_default</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"core.currencies" -> "core.exchange_rates" [label="fk_exchange_rates_from_currency\nfrom_currency_id\n1 : 0..N"];
"core.currencies" -> "core.exchange_rates" [label="fk_exchange_rates_to_currency\nto_currency_id\n1 : 0..N"];
}
