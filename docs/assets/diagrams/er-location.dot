digraph ER {
graph [rankdir=LR, bgcolor="white", nodesep="0.35", ranksep="1.3", splines=polyline, overlap=false, label="Drivique ER — esquema location — ? admite NULL", labelloc=t, fontsize=20, fontname="Arial"];
node [shape=plain,fontname="Arial"];
edge [fontname="Arial",fontsize=8,dir=none,color="#667085"];
"fleet.vehicle_categories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e4e7ec"><B>fleet.vehicle_categories</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR></TABLE>>,fontsize=10];
"iam.users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e4e7ec"><B>iam.users</B></TD></TR><TR><TD ALIGN="LEFT">PK UK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">PK UK</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(254)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">document_type_id</TD><TD ALIGN="LEFT">UUID ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">nationality_id</TD><TD ALIGN="LEFT">UUID ?</TD></TR></TABLE>>,fontsize=10];
"location.branch_categories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>location.branch_categories</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">branch_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"location.branch_users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>location.branch_users</B></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">branch_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">assigned_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"location.branches" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>location.branches</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">city_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">opening_time</TD><TD ALIGN="LEFT">TIME</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">closing_time</TD><TD ALIGN="LEFT">TIME</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">allows_cash_payment</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vehicle_capacity</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">pickup_instructions</TD><TD ALIGN="LEFT">VARCHAR(500) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT">NUMERIC(9, 6) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT">NUMERIC(9, 6) ?</TD></TR></TABLE>>,fontsize=10];
"location.cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>location.cities</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">department_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">has_airport</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">has_terminal</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"location.delivery_drivers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>location.delivery_drivers</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">branch_id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(254) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(30) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">document_type</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">document_number</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">license_number</TD><TD ALIGN="LEFT">VARCHAR(40) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">license_category</TD><TD ALIGN="LEFT">VARCHAR(5) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">license_expires_on</TD><TD ALIGN="LEFT">DATE ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vehicle_description</TD><TD ALIGN="LEFT">VARCHAR(120) ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"location.departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>location.departments</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"location.branches" -> "location.branch_categories" [label="fk_branch_categories_branch\nbranch_id\n1 : 0..N"];
"fleet.vehicle_categories" -> "location.branch_categories" [label="fk_branch_categories_category\ncategory_id\n1 : 0..N"];
"iam.users" -> "location.branch_users" [label="fk_branch_users_user\nuser_id\n1 : 0..N"];
"location.branches" -> "location.branch_users" [label="fk_branch_users_branch\nbranch_id\n1 : 0..N"];
"location.cities" -> "location.branches" [label="fk_branches_city\ncity_id\n1 : 0..N"];
"location.departments" -> "location.cities" [label="fk_cities_department\ndepartment_id\n1 : 0..N"];
"location.branches" -> "location.delivery_drivers" [label="fk_delivery_drivers_branch\nbranch_id\n1 : 0..N"];
}
