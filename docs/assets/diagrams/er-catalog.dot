"catalog.mileage_plans" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>catalog.mileage_plans</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">included_km</TD><TD ALIGN="LEFT">INT ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">daily_rate</TD><TD ALIGN="LEFT">NUMERIC(12, 2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">extra_km_rate</TD><TD ALIGN="LEFT">NUMERIC(12, 2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
"catalog.promotions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>catalog.promotions</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">offer_type</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">discount_type</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">discount_value</TD><TD ALIGN="LEFT">NUMERIC(12, 2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ends_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">minimum_rental_days</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">max_uses_limit</TD><TD ALIGN="LEFT">INT ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">current_uses_count</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
