digraph ER {
graph [rankdir=LR, bgcolor="white", nodesep="0.35", ranksep="1.3", splines=polyline, overlap=false, label="Drivique ER — esquema catalog — ? admite NULL", labelloc=t, fontsize=20, fontname="Arial"];
node [shape=plain,fontname="Arial"];
edge [fontname="Arial",fontsize=8,dir=none,color="#667085"];
"catalog.additional_services" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>catalog.additional_services</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">UUID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">daily_rate</TD><TD ALIGN="LEFT">NUMERIC(12, 2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>,fontsize=10];
