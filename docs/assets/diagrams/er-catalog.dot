digraph ER {
graph [rankdir=LR, bgcolor="white", nodesep="0.35", ranksep="1.3", splines=polyline, overlap=false, label="Drivique ER — esquema catalog — ? admite NULL", labelloc=t, fontsize=20, fontname="Arial"];
