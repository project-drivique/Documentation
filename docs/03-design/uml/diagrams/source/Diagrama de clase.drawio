        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nleft to right direction\ntitle Drivique - Diagrama de Clases (Modelo Lógico Estructural)\n\npackage \&quot;Autenticación y Cuentas (IAM)\&quot; {\n  class User {\n    # id : UUID\n    # firstName : String\n    # lastName : String\n    # email : String\n    # phone : String\n    # accountStatus : String\n    + login() : void\n    + verifyOTP(code: String) : Boolean\n  }\n\n  class UserProfile {\n    - address : String\n    - cityOfResidence : String\n    - avatarUrl : String\n    + updateProfile() : void\n  }\n\n  class Role {\n    - code : String\n    - name : String\n  }\n}\n\npackage \&quot;Catálogo y Flota (Fleet)\&quot; {\n  class Vehicle {\n    - id : UUID\n    - plate : String\n    - model : String\n    - year : Short\n    - dailyRate : Decimal\n    - ratingAverage : Decimal\n    + checkAvailability() : Boolean\n    + updateMileage() : void\n  }\n\n  class VehicleBrand {\n    - name : String\n  }\n\n  class VehicleCategory {\n    - name : String\n    - capacity : Short\n  }\n\n  class VehicleFeature {\n    - name : String\n    - icon : String\n  }\n\n  class VehicleMaintenance {\n    - scheduledAt : DateTime\n    - cost : Decimal\n    - description : String\n    + completeMaintenance() : void\n  }\n}\n\npackage \&quot;Sucursales y Ubicación\&quot; {\n  class Branch {\n    - id : UUID\n    - name : String\n    - address : String\n    - openingTime : Time\n    + assignVehicle() : void\n  }\n\n  class City {\n    - name : String\n    - hasAirport : Boolean\n  }\n\n  class VehicleRestrictionRule {\n    - dayOfWeek : Short\n    - plateLastDigit : Short\n    + evaluateRestriction(plate: String) : Boolean\n  }\n}\n\npackage \&quot;Reservas y Alquiler (Rental)\&quot; {\n  class Reservation {\n    - id : UUID\n    - pickupDate : DateTime\n    - returnDate : DateTime\n    - status : String\n    + confirm() : void\n    + cancel() : void\n  }\n\n  class MileagePlan {\n    - planType : String\n    - dailyRate : Decimal\n  }\n\n  class InsuranceCoverage {\n    - type : String\n    - deductibleAmount : Decimal\n  }\n\n  class Promotion {\n    - code : String\n    - discountValue : Decimal\n    - usageLimit : Integer\n    + applyDiscount(amount: Decimal) : Decimal\n    + checkLimit() : Boolean\n  }\n\n  class DeliveryAssignment {\n    - deliveryAddress : String\n    - nequiPin : String\n    - state : String\n    + verifyPin(pin: String) : Boolean\n    + updateState(newState: String) : void\n  }\n}\n\npackage \&quot;Contratos y Entregas\&quot; {\n  class RentalContract {\n    - contractNumber : String\n    - baseAmount : Decimal\n    - securityDeposit : Decimal\n    + finalize() : void\n  }\n\n  class ContractSignature {\n    - signatureType : String\n    - ipAddress : String\n    - signedAt : DateTime\n  }\n\n  class VehicleInspection {\n    - type : String\n    - fuelLevel : Decimal\n    - observations : String\n  }\n}\n\npackage \&quot;Facturación y Pagos\&quot; {\n  class Payment {\n    - externalReference : String\n    - amount : Decimal\n    - status : String\n    + processWompi() : Boolean\n  }\n\n  class CashConfirmation {\n    - confirmedBy : UUID\n    - notes : String\n    + confirmCashReceived() : void\n  }\n\n  class PaymentReceipt {\n    - receiptNumber : String\n    - documentUrl : String\n  }\n}\n\npackage \&quot;Soporte, Reseñas y Auditoría\&quot; {\n  class SupportTicket {\n    - subject : String\n    - priority : String\n    - status : String\n    + assignAgent() : void\n  }\n\n  class VehicleReview {\n    - rating : Short\n    - comment : String\n  }\n\n  class BranchReview {\n    - rating : Short\n    - comment : String\n    - officialResponse : String\n    - isImmutable : Boolean\n    + addResponse(response: String) : void\n    + makeImmutable() : void\n  }\n\n  class IncidentReport {\n    - subject : String\n    - severity : String\n    + generateReport() : void\n  }\n\n  class AuditLog {\n    - action : String\n    - timestamp : DateTime\n    + logAction(action: String) : void\n  }\n  \n  class Notification {\n    - channel : String\n    - message : String\n    - isRead : Boolean\n    + markAsRead() : void\n  }\n}\n\n&#39; Relaciones IAM\nUser \&quot;1\&quot; *-- \&quot;1\&quot; UserProfile\nUser \&quot;1..*\&quot; -- \&quot;1..*\&quot; Role : posee\n\n&#39; Relaciones Fleet\nVehicle \&quot;1..*\&quot; -- \&quot;1\&quot; VehicleBrand\nVehicle \&quot;1..*\&quot; -- \&quot;1\&quot; VehicleCategory\nVehicle \&quot;1..*\&quot; -- \&quot;0..*\&quot; VehicleFeature : incluye\nVehicle \&quot;1\&quot; -- \&quot;0..*\&quot; VehicleMaintenance : recibe\n\n&#39; Relaciones Ubicación\nBranch \&quot;1..*\&quot; -- \&quot;1\&quot; City\nCity \&quot;1\&quot; -- \&quot;0..*\&quot; VehicleRestrictionRule : aplica\nVehicle \&quot;0..*\&quot; -- \&quot;1\&quot; Branch : asignado a\n\n&#39; Relaciones Reservas\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Reservation : realiza\nReservation \&quot;1\&quot; -- \&quot;1\&quot; Vehicle : renta\nReservation \&quot;1\&quot; -- \&quot;1\&quot; Branch : recogida en\nReservation \&quot;1\&quot; -- \&quot;0..1\&quot; MileagePlan : selecciona\nReservation \&quot;1\&quot; -- \&quot;0..1\&quot; InsuranceCoverage : contrata\nReservation \&quot;1\&quot; -- \&quot;0..*\&quot; Promotion : aplica\nReservation \&quot;1\&quot; -- \&quot;0..1\&quot; DeliveryAssignment : domicilio\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; DeliveryAssignment : conductor asignado\n\n&#39; Relaciones Contrato\nReservation \&quot;1\&quot; -- \&quot;0..1\&quot; RentalContract : genera\nRentalContract \&quot;1\&quot; *-- \&quot;1..*\&quot; ContractSignature : firmado con\nRentalContract \&quot;1\&quot; -- \&quot;1..2\&quot; VehicleInspection : requiere\n\n&#39; Relaciones Pagos\nReservation \&quot;1\&quot; -- \&quot;1..*\&quot; Payment : requiere\nPayment \&quot;1\&quot; -- \&quot;0..1\&quot; CashConfirmation : validación efectivo\nPayment \&quot;1\&quot; -- \&quot;1\&quot; PaymentReceipt : emite\n\n&#39; Relaciones Soporte y Auditoría\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; SupportTicket : crea\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; VehicleReview : escribe\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; BranchReview : evalúa\nVehicle \&quot;1\&quot; -- \&quot;0..*\&quot; VehicleReview : recibe\nBranch \&quot;1\&quot; -- \&quot;0..*\&quot; BranchReview : recibe\nVehicle \&quot;1\&quot; -- \&quot;0..*\&quot; IncidentReport : reporta\nBranch \&quot;1\&quot; -- \&quot;0..*\&quot; AuditLog : monitoreado por\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Notification : recibe\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="eOamKmrwR5u9OO82zSn6-1">
