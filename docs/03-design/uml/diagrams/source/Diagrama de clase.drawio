        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide methods\nskinparam classAttributeIconSize 0\n\ntitle Drivique - Modelo de Dominio Conceptual (Contextos Delimitados)\n\npackage \&quot;Gestión de Usuarios\&quot; {\n  class User {\n    id\n    firstName\n    lastName\n    email\n    phone\n  }\n\n  class Driver {\n    licenseNumber\n    isAvailable\n  }\n}\n\npackage \&quot;Gestión de Flota\&quot; {\n  class Branch {\n    id\n    name\n    address\n    openingTime\n  }\n\n  class Vehicle {\n    id\n    plate\n    model\n    status\n  }\n}\n\npackage \&quot;Operaciones de Alquiler\&quot; {\n  class Reservation {\n    id\n    pickupDate\n    returnDate\n    status\n  }\n\n  class RentalContract {\n    contractNumber\n    baseAmount\n    finalAmount\n  }\n\n  class DeliveryAssignment {\n    id\n    nequi_pin\n    state\n  }\n\n  class Promotion {\n    id\n    type\n    discountValue\n    limit\n  }\n}\n\npackage \&quot;Facturación\&quot; {\n  class Payment {\n    id\n    amount\n    status\n    paymentDate\n  }\n}\n\npackage \&quot;Calidad y Auditoría\&quot; {\n  class BranchReview {\n    id\n    rating\n    comment\n    official_response\n    is_immutable\n  }\n\n  class IncidentReport {\n    id\n    description\n    severityLevel\n    reportedAt\n  }\n\n  class AuditLog {\n    id\n    action\n    timestamp\n  }\n}\n\n&#39; RELACIONES CONCEPTUALES\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Reservation : \&quot;realiza\&quot;\nReservation \&quot;1\&quot; -- \&quot;1\&quot; Vehicle : \&quot;reserva\&quot;\nReservation \&quot;1\&quot; -- \&quot;1\&quot; Branch : \&quot;origen\&quot;\nReservation \&quot;1\&quot; -- \&quot;1\&quot; Branch : \&quot;destino\&quot;\nBranch \&quot;1\&quot; -- \&quot;1..*\&quot; Vehicle : \&quot;gestiona\&quot;\n\nReservation \&quot;1\&quot; -- \&quot;0..1\&quot; RentalContract : \&quot;formaliza\&quot;\nReservation \&quot;1\&quot; -- \&quot;1..*\&quot; Payment : \&quot;abona\&quot;\nReservation \&quot;1\&quot; -- \&quot;0..*\&quot; Promotion : \&quot;aplica\&quot;\n\nReservation \&quot;1\&quot; -- \&quot;0..1\&quot; DeliveryAssignment : \&quot;solicita\&quot;\nDriver \&quot;1\&quot; -- \&quot;0..*\&quot; DeliveryAssignment : \&quot;ejecuta\&quot;\n\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; BranchReview : \&quot;evalúa\&quot;\nBranch \&quot;1\&quot; -- \&quot;0..*\&quot; BranchReview : \&quot;recibe\&quot;\n\nVehicle \&quot;1\&quot; -- \&quot;0..*\&quot; IncidentReport : \&quot;sufre\&quot;\nDriver \&quot;1\&quot; -- \&quot;0..*\&quot; IncidentReport : \&quot;reporta\&quot;\n\nBranch \&quot;1\&quot; -- \&quot;0..*\&quot; AuditLog : \&quot;auditada por\&quot;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WKLkEMRnYbQK2GmCauy2-1">
