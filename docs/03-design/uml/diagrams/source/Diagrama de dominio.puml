@startuml
!pragma PLANTUML_LIMIT_SIZE 16384
skinparam dpi 300

title Modelo de Dominio - Drivique

skinparam classAttributeIconSize 0
skinparam shadowing false
left to right direction

' =========================
' IDENTIDAD Y AUDITORÍA
' =========================

class Usuario {
    nombre
    apellido
    documento
    correo
    telefono
}

class RegistroAuditoria {
    entidadAfectada
    operacion
    resultado
    descripcion
}

Usuario "1" -- "0..*" RegistroAuditoria : genera accion >

' =========================
' UBICACIÓN
' =========================

class Departamento {
    nombre
}

class Ciudad {
    nombre
}

class Sucursal {
    nombre
    direccion
    telefono
}

Departamento "1" -- "0..*" Ciudad : contiene
Ciudad "1" -- "0..*" Sucursal : tiene

' =========================
' FLOTA
' =========================

class Vehiculo {
    placa
    VIN
    modelo
    año
    color
    kilometraje
    capacidadPasajeros
    numeroPuertas
    combustible
    transmision
}

class Marca {
    nombre
}

class CategoriaVehiculo {
    nombre
    descripcion
}

Marca "1" -- "0..*" Vehiculo : identifica
CategoriaVehiculo "1" -- "0..*" Vehiculo : clasifica

Sucursal "1" -- "0..*" Vehiculo : dispone de

' =========================
' ALQUILER Y ENTREGAS
' =========================

class Reserva {
    codigo
    fechaHoraRecogida
    fechaHoraDevolucion
    tarifaDiaria
    totalEstimado
    estado
}

class SolicitudExtension {
    fechaSolicitud
    nuevaFechaDevolucion
    motivo
    estado
}

class ContratoAlquiler {
    fechaInicio
    fechaFin
    precioTotal
    estado
}

class InspeccionVehiculo {
    fecha
    kilometraje
    nivelCombustible
    observaciones
    daños
}

class AsignacionDomicilio {
    nequi_pin
    estado
}

Usuario "1" -- "0..*" Reserva : realiza

Reserva "1" -- "1" Vehiculo : reserva

Reserva "1" -- "1" Sucursal : recoge en
Reserva "1" -- "1" Sucursal : devuelve en

Reserva "1" -- "0..*" SolicitudExtension : solicita

Reserva "1" -- "0..1" ContratoAlquiler : genera

Reserva "1" -- "0..1" AsignacionDomicilio : asignada a entrega >

ContratoAlquiler "1" -- "0..*" InspeccionVehiculo : registra

Vehiculo "1" -- "0..*" InspeccionVehiculo : es inspeccionado


' =========================
' SERVICIOS Y OFERTAS
' =========================

class ServicioAdicional {
    nombre
    descripcion
    precio
}

class CoberturaSeguro {
    nombre
    descripcion
    precio
}

class PlanKilometraje {
    nombre
    kilometrosIncluidos
    precio
}

class Promocion {
    nombre
    descripcion
    tipo
    descuento
    limiteUso
    fechaInicio
    fechaFin
}

Reserva "0..*" -- "0..*" ServicioAdicional : incluye
Reserva "0..*" -- "0..*" CoberturaSeguro : incluye
Reserva "0..*" -- "0..1" PlanKilometraje : selecciona
Reserva "0..*" -- "0..*" Promocion : aplica

' =========================
' PAGOS
' =========================

class Pago {
    monto
    fecha
    estado
}

class MetodoPago {
    nombre
}

class ComprobantePago {
    numero
    fecha
}

Reserva "1" -- "0..*" Pago : genera

Pago "1" -- "1" MetodoPago : utiliza

Pago "1" -- "0..1" ComprobantePago : genera

' =========================
' SOPORTE
' =========================

class TicketSoporte {
    asunto
    descripcion
    prioridad
    estado
    fechaCreacion
}

class MensajeTicket {
    contenido
    fecha
}

class ReporteIncidente {
    descripcion
    fecha
    gravedad
    estado
}

Usuario "1" -- "0..*" TicketSoporte : crea

TicketSoporte "1" -- "0..*" MensajeTicket : contiene

Usuario "1" -- "0..*" ReporteIncidente : reporta

Vehiculo "1" -- "0..*" ReporteIncidente : presenta

' =========================
' EXPERIENCIA
' =========================

class Notificacion {
    titulo
    mensaje
    fecha
    leida
}

class ResenaVehiculo {
    calificacion
    comentario
    fecha
}

class ResenaSucursal {
    calificacion
    comentario
    respuestaOficial
    esInmutable
    fecha
}

Usuario "1" -- "0..*" Notificacion : recibe

Usuario "1" -- "0..*" ResenaVehiculo : escribe
Vehiculo "1" -- "0..*" ResenaVehiculo : recibe

Usuario "1" -- "0..*" ResenaSucursal : escribe
Sucursal "1" -- "0..*" ResenaSucursal : recibe

@enduml
